{
  "name": "pixel-pincher",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension for overlaying reference images on web pages.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "wxt build && node scripts/assert-runtime-proof-build.mjs",
    "dev": "wxt",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.306",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.29.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4",
    "wxt": "^0.20.4"
  }
}
